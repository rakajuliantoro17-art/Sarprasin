{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },

    {
      "source": "/login",
      "destination": "/login/index.html"
    },

    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },

    {
      "source": "/executive",
      "destination": "/executive/index.html"
    },

    {
      "source": "/user",
      "destination": "/user/index.html"
    },

    {
      "source": "/public",
      "destination": "/public/index.html"
    },

    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },

    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
