```json
{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },

    {
      "source": "/login",
      "destination": "/login/index.html"
    },

    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },

    {
      "source": "/executive",
      "destination": "/executive/index.html"
    },

    {
      "source": "/user",
      "destination": "/user/index.html"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
```
