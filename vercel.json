{
  "version": 2,

  "cleanUrls": true,

  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/pages/dashboard/index.html"
    },
    {
      "source": "/login",
      "destination": "/pages/login/index.html"
    },
    {
      "source": "/profile",
      "destination": "/pages/profile/index.html"
    },
    {
      "source": "/settings",
      "destination": "/pages/settings/index.html"
    },
    {
      "source": "/asset",
      "destination": "/pages/asset/index.html"
    },
    {
      "source": "/report",
      "destination": "/pages/report/index.html"
    },
    {
      "source": "/executive",
      "destination": "/pages/executive/index.html"
    },
    {
      "source": "/maintenance",
      "destination": "/pages/maintenance/index.html"
    }
  ],

  "headers": [
    {
      "source": "/assets/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],

  "build": {
    "env": {
      "APP_NAME": "SMANSASOO Digital System"
    }
  }
}
