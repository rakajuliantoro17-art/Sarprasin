# ==========================================================
# SMANSASOO DIGITAL SYSTEM
# ENVIRONMENT CONFIGURATION
# Version : 1.0.0
# ==========================================================


# ===============================
# APPLICATION
# ===============================

APP_NAME="SMANSASOO Digital System"

APP_VERSION="1.0.0"

APP_ENV="production"


# ===============================
# SCHOOL INFORMATION
# ===============================

SCHOOL_NAME="SMAN 1 Sooko"

SCHOOL_CODE="SMANSASOO"

SCHOOL_REGION="Mojokerto"


# ===============================
# BASE URL
# ===============================

APP_URL="https://your-domain.vercel.app"



# ===============================
# FIREBASE CONFIGURATION
# ===============================

FIREBASE_API_KEY=""

FIREBASE_AUTH_DOMAIN=""

FIREBASE_DATABASE_URL=""

FIREBASE_PROJECT_ID=""

FIREBASE_STORAGE_BUCKET=""

FIREBASE_MESSAGING_SENDER_ID=""

FIREBASE_APP_ID=""



# ===============================
# AUTHENTICATION
# ===============================

AUTH_SECRET=""

SESSION_EXPIRE="3600"



# ===============================
# CBT LOCK SYSTEM
# ===============================

CBT_MODE="production"

CBT_SECURITY_LEVEL="high"

CBT_MAX_SESSION="1500"

OTP_SECRET=""



# ===============================
# INVENTORY SYSTEM
# ===============================

INVENTORY_VERSION="1.0"

INVENTORY_DATABASE="firebase"



# ===============================
# API CONFIGURATION
# ===============================

API_BASE_URL=""

API_TIMEOUT="10000"



# ===============================
# FEATURE FLAGS
# ===============================

ENABLE_DARK_MODE=true

ENABLE_NOTIFICATION=true

ENABLE_REPORT=true

ENABLE_CBT_LOCK=true

ENABLE_SMART_INVENTORY=true



# ===============================
# DEBUG
# ===============================

DEBUG=false
